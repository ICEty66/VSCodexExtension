                <TabItem Header="智能体">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border
                            Grid.Row="0"
                            Margin="0,0,0,8"
                            Style="{StaticResource SettingsSectionBorderStyle}"
                            Visibility="Collapsed">
                            <DockPanel>
                                <TextBlock
                                    DockPanel.Dock="Top"
                                    Style="{StaticResource SettingsSectionHeadingStyle}"
