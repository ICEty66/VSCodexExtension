                                                <Grid Grid.Row="3" Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="140" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Margin="0,0,6,0"
                                                        Style="{StaticResource FieldLabelTextBlock}"
                                                        Text="模型" />
                                                    <ComboBox
                                                        Grid.Column="1"
                                                        MinWidth="140"
                                                        IsEditable="True"
                                                        ItemsSource="{Binding DataContext.ModelOptions, ElementName=Root}"
                                                        Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Margin="8,0,6,0"
                                                        Style="{StaticResource FieldLabelTextBlock}"
                                                        Text="模式" />
                                                    <ComboBox
                                                        Grid.Column="3"
                                                        ItemsSource="{Binding DataContext.AgentModelSelectionModeOptions, ElementName=Root}"
                                                        SelectedItem="{Binding ModelSelectionMode}" />
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
