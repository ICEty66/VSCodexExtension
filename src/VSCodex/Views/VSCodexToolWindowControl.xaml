                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>
                <TabItem Header="工作树">
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="托管的本地 Git 工作树" FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,8" TextWrapping="Wrap" Text="在独立检出中创建 CP_ 分支。归档会把该检出连同已验证的恢复快照一起收起，恢复则将其还原。处于活动、已固定、外部以及被 Git 锁定的检出均受保护。" />
                            <WrapPanel>
                                <TextBox Width="180" Text="{Binding NewWorktreeBranch, UpdateSourceTrigger=PropertyChanged}" ToolTip="以 CP_ 开头的新分支名" />
                                <Button
                                    Command="{Binding CreateWorktreeCommand}"
                                    Margin="4,0"
                                    Content="{x:Static catalog:KnownMonikers.Branch}"
                                    Style="{StaticResource NativeIconButtonStyle}"
                                    AutomationProperties.Name="创建托管工作树"
                                    ToolTip="基于已提交的 HEAD 创建新的 CP_ 分支与隔离检出。" />
                                <Button
                                    Command="{Binding RefreshWorktreesCommand}"
                                    Content="{x:Static catalog:KnownMonikers.Refresh}"
                                    Style="{StaticResource NativeIconButtonStyle}"
                                    AutomationProperties.Name="刷新托管工作树"
                                    ToolTip="刷新 Git 检出与托管归档状态。" />
                            </WrapPanel>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Worktrees}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="6" Margin="0,4" BorderThickness="1" BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Branch}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Path}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Description}" />
                                                <WrapPanel Margin="0,4,0,0">
                                                    <Button
                                                        Command="{Binding DataContext.OpenWorktreeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="{x:Static catalog:KnownMonikers.OpenFolder}"
                                                        Style="{StaticResource NativeIconButtonStyle}"
                                                        AutomationProperties.Name="打开工作树文件夹"
                                                        ToolTip="在文件浏览器中打开此检出。" />
                                                    <Button
                                                        Margin="4,0"
                                                        IsEnabled="{Binding IsManaged}"
                                                        Command="{Binding DataContext.PinWorktreeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" >
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource NativeIconButtonStyle}">
                                                                <Setter Property="Content" Value="{x:Static catalog:KnownMonikers.Pin}" />
                                                                <Setter Property="ToolTip" Value="固定此工作树，防止其被归档。" />
                                                                <Setter Property="AutomationProperties.Name" Value="固定此工作树，防止其被归档。" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                        <Setter Property="Content" Value="{x:Static catalog:KnownMonikers.Unpin}" />
                                                                        <Setter Property="ToolTip" Value="取消固定此工作树。" />
                                                                        <Setter Property="AutomationProperties.Name" Value="取消固定此工作树。" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button
                                                        IsEnabled="{Binding IsManaged}"
                                                        Command="{Binding DataContext.ArchiveWorktreeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" >
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource NativeIconButtonStyle}">
                                                                <Setter Property="Content" Value="{x:Static catalog:KnownMonikers.FolderClosed}" />
                                                                <Setter Property="ToolTip" Value="在保留已验证恢复快照的前提下归档此检出。" />
                                                                <Setter Property="AutomationProperties.Name" Value="在保留已验证恢复快照的前提下归档此检出。" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                                                        <Setter Property="Content" Value="{x:Static catalog:KnownMonikers.OpenFolder}" />
                                                                        <Setter Property="ToolTip" Value="将此已归档检出还原到其托管位置。" />
                                                                        <Setter Property="AutomationProperties.Name" Value="将此已归档检出还原到其托管位置。" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
                <TabItem Header="自动化">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">
                            <TextBlock Text="本地计划会在此工具窗口于 Visual Studio 中打开期间运行。错过的执行会合并为一次。保存后的计划默认为暂停状态。" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding AutomationStatus}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <TextBlock Text="名称" Margin="0,8,0,2" />
                            <TextBox Text="{Binding AutomationName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="提示词" Margin="0,8,0,2" />
                            <TextBox Text="{Binding AutomationPrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="64" TextWrapping="Wrap" />
                            <TextBlock Text="间隔（分钟）" Margin="0,8,0,2" />
                            <TextBox Text="{Binding AutomationMinutes, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                            <Button
                                Command="{Binding AddAutomationCommand}"
                                Margin="0,8,0,8"
                                Content="{x:Static catalog:KnownMonikers.Save}"
                                Style="{StaticResource NativeIconButtonStyle}"
                                AutomationProperties.Name="保存已暂停的自动化"
                                ToolTip="为当前工作区保存此提示词与间隔。计划保存后为暂停状态。" />
                            <TextBlock Text="计划会在独立的只读 CLI 进程中执行，不进行交互式批准。结果与未读状态都保存在本地。" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Automations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1" Padding="8" Margin="0,8,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Workspace}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding IntervalMinutes, StringFormat='间隔：{0} 分钟'}" />
                                                <TextBlock Text="{Binding Enabled, StringFormat='已启用：{0}'}" />
                                                <TextBlock Text="{Binding NextDue, StringFormat='下次到期（UTC）：{0:g}'}" />
                                                <WrapPanel>
                                                    <Button
                                                        Command="{Binding DataContext.ToggleAutomationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" >
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource NativeIconButtonStyle}">
                                                                <Setter Property="Content" Value="{x:Static catalog:KnownMonikers.Play}" />
                                                                <Setter Property="ToolTip" Value="启用此已暂停的自动化。" />
                                                                <Setter Property="AutomationProperties.Name" Value="启用此已暂停的自动化。" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                                        <Setter Property="Content" Value="{x:Static catalog:KnownMonikers.Pause}" />
                                                                        <Setter Property="ToolTip" Value="暂停此自动化后续的运行。" />
                                                                        <Setter Property="AutomationProperties.Name" Value="暂停此自动化后续的运行。" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button
                                                        Command="{Binding DataContext.ReadAutomationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="{x:Static catalog:KnownMonikers.Checkmark}"
                                                        Style="{StaticResource NativeIconButtonStyle}"
                                                        AutomationProperties.Name="将自动化结果标记为已读"
                                                        ToolTip="将该自动化的最新结果标记为已读。" />
                                                    <Button
                                                        Command="{Binding DataContext.DeleteAutomationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="{x:Static catalog:KnownMonikers.Delete}"
                                                        Style="{StaticResource NativeIconButtonStyle}"
                                                        AutomationProperties.Name="删除自动化"
                                                        ToolTip="删除该计划及其最新通知。" />
                                                </WrapPanel>
                                                <TextBlock Text="{Binding Unread, StringFormat='未读结果：{0}'}" />
                                                <TextBlock Text="{Binding LastFailed, StringFormat='最近运行失败：{0}'}" />
                                                <TextBlock Text="{Binding LastCompleted, StringFormat='最近完成（UTC）：{0:g}'}" />
                                                <TextBox Text="{Binding LastResult, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="240" VerticalScrollBarVisibility="Auto" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>

        <Border
            Grid.Row="2"
            MaxHeight="{Binding ActualHeight, ElementName=Root, Converter={StaticResource ComposerHeightConverter}}"
            Margin="12,10,12,8"
            Padding="12,10"
            Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
            BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}"
            BorderThickness="1"
            CornerRadius="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,4">
                    <ItemsControl ItemsSource="{Binding ApprovalRequests}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="10,8"
                                    Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowCodeBlockBackgroundBrushKey}}"
                                    BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowValidationErrorBorderBrushKey}}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{Binding Reason}" />
                                        <Expander Header="请求详情" IsExpanded="False" Margin="0,3,0,6"
                                                  Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}">
                                            <TextBox MaxHeight="100" IsReadOnly="True" Text="{Binding ArgumentsPreview}"
                                                     FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto" />
                                        </Expander>
                                        <controls:ElicitationFormControl Form="{Binding Form}" />
                                        <WrapPanel>
                                            <Button ToolTip="批准。" AutomationProperties.Name="批准"
                                                Command="{Binding DataContext.ApproveRequestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="{x:Static catalog:KnownMonikers.Play}"
                                                Style="{StaticResource NativeIconButtonStyle}" />
                                            <Button ToolTip="拒绝。" AutomationProperties.Name="拒绝"
                                                Command="{Binding DataContext.DeclineRequestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="{x:Static catalog:KnownMonikers.Cancel}"
                                                Style="{StaticResource NativeIconButtonStyle}" />
                                            <Button ToolTip="取消。" AutomationProperties.Name="取消"
                                                Command="{Binding DataContext.CancelRequestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="{x:Static catalog:KnownMonikers.Cancel}"
                                                Style="{StaticResource NativeIconButtonStyle}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        Margin="0,0,0,6"
                        HorizontalAlignment="Center"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
                        Text="要构建什么？">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding RunActivityRoots.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <TextBlock
                        Margin="0,0,0,8"
                        HorizontalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.SystemGrayTextBrushKey}}"
                        Text="使用 # 引用选中代码、/ 调用命令、@ 引用文件。"
                        ToolTip="用 # 或 @ 附加工作区上下文，或用 / 选择一条聚焦命令。" />
                    <WrapPanel x:Name="ConversationActionPanel" AutomationProperties.Name="会话操作">
                        <Button Command="{Binding ReviewSelectionCommand}" AutomationProperties.Name="审阅选中代码"
                                ToolTip="审阅选中代码。" Style="{StaticResource IconButtonStyle}">
                            <imaging:CrispImage Width="16" Height="16" Moniker="{x:Static catalog:KnownMonikers.CodeReview}" />
                        </Button>
                        <Button Command="{Binding ReviewActiveFileCommand}" AutomationProperties.Name="审阅当前文件的更改"
                                ToolTip="将当前编辑器文件与 Git HEAD 比较。" Style="{StaticResource IconButtonStyle}">
                            <imaging:CrispImage Width="16" Height="16" Moniker="{x:Static catalog:KnownMonikers.CompareFiles}" />
                        </Button>
                        <Button Command="{Binding DebugSelectionCommand}" AutomationProperties.Name="调试活动错误"
                                ToolTip="调试当前活动的错误。" Style="{StaticResource IconButtonStyle}">
                            <imaging:CrispImage Width="16" Height="16" Moniker="{x:Static catalog:KnownMonikers.Repair}" />
                        </Button>
                        <Button Command="{Binding CreateTestForSelectionCommand}" AutomationProperties.Name="为选中代码编写测试"
                                ToolTip="为选中代码编写测试。" Style="{StaticResource IconButtonStyle}">
                            <imaging:CrispImage Width="16" Height="16" Moniker="{x:Static catalog:KnownMonikers.Test}" />
                        </Button>
                        <Button Command="{Binding CreatePlanCommand}" AutomationProperties.Name="规划工作"
                                ToolTip="规划工作。" Style="{StaticResource IconButtonStyle}">
                            <imaging:CrispImage Width="16" Height="16" Moniker="{x:Static catalog:KnownMonikers.TaskList}" />
                        </Button>
                        <Button Command="{Binding RefreshCommand}" AutomationProperties.Name="刷新工作区引用"
                                ToolTip="刷新工作区引用。" Style="{StaticResource IconButtonStyle}">
                            <imaging:CrispImage Width="16" Height="16" Moniker="{x:Static catalog:KnownMonikers.Refresh}" />
                        </Button>
                        <Button Command="{Binding ExplainSelectionCommand}" AutomationProperties.Name="解释选中代码"
                                ToolTip="解释选中代码。" Style="{StaticResource IconButtonStyle}">
                            <imaging:CrispImage Width="16" Height="16" Moniker="{x:Static catalog:KnownMonikers.Document}" />
                        </Button>
                        <Button Command="{Binding FixSelectionCommand}" AutomationProperties.Name="修复选中代码"
                                ToolTip="修复选中代码。" Style="{StaticResource IconButtonStyle}">
                            <imaging:CrispImage Width="16" Height="16" Moniker="{x:Static catalog:KnownMonikers.Repair}" />
                        </Button>
                        <Button Command="{Binding OptimizeSelectionCommand}" AutomationProperties.Name="优化选中代码"
                                ToolTip="优化选中代码。" Style="{StaticResource IconButtonStyle}">
                            <imaging:CrispImage Width="16" Height="16" Moniker="{x:Static catalog:KnownMonikers.Performance}" />
                        </Button>
                        <Button Command="{Binding GenerateDocsCommand}" AutomationProperties.Name="为选中代码生成文档"
                                ToolTip="为选中代码生成文档。" Style="{StaticResource IconButtonStyle}">
                            <imaging:CrispImage Width="16" Height="16" Moniker="{x:Static catalog:KnownMonikers.Document}" />
                        </Button>
                    </WrapPanel>
                </StackPanel>

                <primitives:Thumb
                    Grid.Row="1"
                    Margin="0,0,0,2"
                    DragCompleted="OnPromptResizeDragCompleted"
                    DragDelta="OnPromptResizeDragDelta"
                    DragStarted="OnPromptResizeDragStarted"
                    LostMouseCapture="OnPromptResizeLostMouseCapture"
                    PreviewMouseLeftButtonUp="OnPromptResizeMouseLeftButtonUp"
                    Style="{StaticResource PromptResizeThumbStyle}"
                    ToolTip="拖动可调整提示词输入框的大小。" />

                <TextBox
                    x:Name="PromptTextBox"
                    Grid.Row="2"
                    Height="{Binding InputAreaHeight}"
                    MinHeight="32"
                    MaxHeight="600"
                    AllowDrop="True"
                    AutomationProperties.Name="VSCodex 提示词输入框"
                    Drop="OnPromptDrop"
                    PreviewDragOver="OnPromptPreviewDragOver"
                    PreviewKeyDown="OnPromptPreviewKeyDown"
                    Style="{StaticResource ComposerPromptTextBoxStyle}"
                    Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="向 VSCodex 提问。Enter 按已配置的后续行为执行，Ctrl+Enter 执行相反行为，Shift+Enter 换行，Esc 停止。可使用 /MCP、/debug、/test、/plan、@文件名 或 #选中内容。" />

                <Popup
                    x:Name="PromptSuggestionPopup"
                    Grid.Row="2"
                    AllowsTransparency="True"
                    IsOpen="{Binding IsPromptSuggestionOpen, Mode=TwoWay}"
                    Placement="Top"
                    PlacementTarget="{Binding ElementName=PromptTextBox}"
                    StaysOpen="True">
                    <Border
                        Width="{Binding ActualWidth, ElementName=PromptTextBox}"
                        MaxHeight="260"
                        Padding="1"
                        Background="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxPopupBackgroundBeginBrushKey}}"
                        BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}"
                        BorderThickness="1">
                        <ListBox
                            x:Name="PromptSuggestionList"
                            MaxHeight="250"
                            ItemsSource="{Binding PromptSuggestions}"
                            KeyboardNavigation.DirectionalNavigation="Contained"
                            MouseDoubleClick="OnPromptSuggestionDoubleClick"
                            SelectedItem="{Binding SelectedPromptSuggestion, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="6,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            FontWeight="SemiBold"
                                            Opacity="0.78"
                                            Text="{Binding Kind}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{Binding DisplayText}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Opacity="0.72"
                                                Text="{Binding Detail}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>

                <WrapPanel
                    Grid.Row="3"
                    Margin="0,8,0,0"
                    VerticalAlignment="Center">
                    <TextBlock
                        Style="{StaticResource ComposerChipTextStyle}"
                        Text="访问权限" />
                    <ComboBox
                        Width="132"
                        MinWidth="118"
                        AutomationProperties.Name="VSCodex 访问级别"
                        IsHitTestVisible="{Binding CanEditSettings}"
                        ItemsSource="{Binding AccessLevelOptions}"
                        SelectedItem="{Binding AccessLevel}"
                        ToolTip="此 VSCodex 请求的文件系统访问权限。" />
                    <TextBlock
                        Margin="4,0,5,6"
                        Style="{StaticResource ComposerChipTextStyle}"
                        Text="模式" />
                    <ComboBox
                        Width="118"
                        MinWidth="118"
                        AutomationProperties.Name="VSCodex 请求模式"
                        IsHitTestVisible="{Binding CanEditSettings}"
                        ItemsSource="{Binding ModeOptions}"
                        SelectedItem="{Binding Mode}"
                        ToolTip="此请求的 VSCodex 模式。" />
                    <TextBlock
                        Margin="4,0,5,6"
                        Style="{StaticResource ComposerChipTextStyle}"
                        Text="模型" />
                    <ComboBox
                        Width="150"
                        MinWidth="118"
                        AutomationProperties.Name="VSCodex 模型"
                        IsEditable="True"
                        IsHitTestVisible="{Binding CanEditSettings}"
                        ItemsSource="{Binding ModelOptions}"
                        Text="{Binding SelectedModel, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="此请求使用的主模型。" />
                    <TextBlock
                        Margin="4,0,5,6"
                        Style="{StaticResource ComposerChipTextStyle}"
                        Text="推理" />
                    <ComboBox
                        Width="112"
                        MinWidth="96"
                        AutomationProperties.Name="VSCodex 推理强度"
                        IsEditable="True"
                        IsHitTestVisible="{Binding CanEditSettings}"
                        ItemsSource="{Binding ReasoningOptions}"
                        Text="{Binding SelectedReasoning, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                        ToolTip="此请求的推理强度。" />
                    <Button
                        AutomationProperties.Name="引导当前 VSCodex 回合"
                        Command="{Binding SteerCommand}"
                        Content="{x:Static catalog:KnownMonikers.Play}"
                        Style="{StaticResource NativeIconButtonStyle}"
                        ToolTip="立即把当前提示词加入正在进行的回合。"
                        Visibility="{Binding IsPauseControlVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button
                        AutomationProperties.Name="排队 VSCodex 后续消息"
                        Command="{Binding QueueCommand}"
                        Content="{x:Static catalog:KnownMonikers.AddToCollection}"
                        Style="{StaticResource NativeIconButtonStyle}"
                        ToolTip="在此回合结束后运行当前提示词。"
                        Visibility="{Binding IsPauseControlVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button
                        AutomationProperties.Name="暂停 VSCodex 请求"
                        Command="{Binding PauseCommand}"
                        Content="{x:Static catalog:KnownMonikers.Pause}"
                        Style="{StaticResource NativeIconButtonStyle}"
                        ToolTip="中断此回合，并将其上下文保存到 ReactiveMemory。"
                        Visibility="{Binding IsPauseControlVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button
                        AutomationProperties.Name="恢复已暂停的 VSCodex 请求"
                        Command="{Binding ResumeCommand}"
                        Content="{x:Static catalog:KnownMonikers.Play}"
                        Style="{StaticResource NativeIconButtonStyle}"
                        ToolTip="还原持久化的 ReactiveMemory 检查点并继续。"
                        Visibility="{Binding IsResumeControlVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button
                        VerticalAlignment="Center"
                        AutomationProperties.Name="切换 VSCodex 语音输入"
                        Click="OnToggleVoiceInputClick"
                        Style="{StaticResource VoiceInputButtonStyle}">
                        <Grid Width="16" Height="16">
                            <Path
                                Data="M8,2 A2,2 0 0 1 10,4 L10,8 A2,2 0 0 1 6,8 L6,4 A2,2 0 0 1 8,2 Z M4,7 L4,8 A4,4 0 0 0 12,8 L12,7 M8,12 L8,15 M5.5,15 L10.5,15"
                                Stretch="Uniform"
                                Stroke="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
                                StrokeEndLineCap="Square"
                                StrokeLineJoin="Round"
                                StrokeThickness="1.5">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsListeningToVoice}" Value="True">
                                                <Setter Property="Stroke" Value="{DynamicResource {x:Static vsui:EnvironmentColors.FileTabSelectedTextBrushKey}}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <Ellipse
                                x:Name="VoiceListeningDot"
                                Width="5"
                                Height="5"
                                Margin="0,0,-1,-1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Fill="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowValidationErrorTextBrushKey}}"
                                Stroke="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
                                StrokeThickness="1"
                                Visibility="{Binding IsListeningToVoice, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Button>
                    <TextBlock
                        Margin="2,0,8,6"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowValidationErrorTextBrushKey}}"
                        Text="聆听中"
                        Visibility="{Binding IsListeningToVoice, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button
                        VerticalAlignment="Center"
                        AutomationProperties.Name="发送或停止 VSCodex 请求"
                        Click="OnRunControlClick"
                        Style="{StaticResource PrimaryRunButtonStyle}">
                        <Grid Width="18" Height="18">
                            <Path
                                x:Name="SendIcon"
                                Width="14"
                                Height="14"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="M7,13 L7,2 M2.5,6.5 L7,2 L11.5,6.5"
                                Stretch="Uniform"
                                Stroke="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
                                StrokeEndLineCap="Square"
                                StrokeLineJoin="Miter"
                                StrokeThickness="1.8">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunControlInStopMode}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <Grid x:Name="StopIcon">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunControlInStopMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <controls:ProgressRing
                                    Width="18"
                                    Height="18"
                                    Margin="0"
                                    IsIndeterminate="True"
                                    Opacity="0.35" />
                                <Rectangle
                                    Width="8"
                                    Height="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Fill="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
                            </Grid>
                        </Grid>
                    </Button>
                    <Button
                        Margin="4,0,0,6"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="停止 VSCodex 请求"
                        Click="OnStopControlClick"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="停止当前 VSCodex 请求。已排队的提示词会保留。"
                        Visibility="{Binding IsPersistentStopControlVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid Width="16" Height="16">
                            <controls:ProgressRing
                                Width="16"
                                Height="16"
                                Margin="0"
                                IsIndeterminate="True"
                                Opacity="0.35" />
                            <Rectangle
                                Width="7"
                                Height="7"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Fill="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
                        </Grid>
                    </Button>
                    <TextBlock
                        Margin="6,0,0,6"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Opacity="0.72"
                        Text="{Binding QueueStatusDisplay}"
                        Visibility="{Binding HasQueuedPrompts, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </WrapPanel>
            </Grid>
            </ScrollViewer>
        </Border>

        <StatusBar Grid.Row="3" MaxHeight="28">
            <StatusBarItem MaxWidth="500" ToolTip="{Binding Status}">
                <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem Content="线程：" />
            <StatusBarItem Content="{Binding ThreadId}" />
            <Separator />
            <StatusBarItem Content="{Binding RateLimitUpdatedAt}" />
        </StatusBar>
    </Grid>
</UserControl>
