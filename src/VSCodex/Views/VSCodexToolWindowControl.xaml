                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*" MinWidth="230" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="1.35*" MinWidth="260" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource SettingsSectionBorderStyle}">
                                <DockPanel>
                                    <TextBlock
                                        DockPanel.Dock="Top"
                                        Style="{StaticResource SettingsSectionHeadingStyle}"
                                        Text="工具" />
