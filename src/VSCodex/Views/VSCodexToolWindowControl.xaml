<UserControl
    x:Class="VSCodex.Views.VSCodexToolWindowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VSCodex.Controls"
    xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
    xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
    xmlns:models="clr-namespace:VSCodex.Models"
    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
    xmlns:views="clr-namespace:VSCodex.Views"
    xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
    x:Name="Root"
    MinWidth="240"
    MinHeight="120"
    Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
    Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}">
    <UserControl.Resources>
        <views:RoleBrushConverter x:Key="RoleBrushConverter" />
        <views:AvailableWidthConverter x:Key="TreeItemAvailableWidthConverter" Gutter="28" />
        <views:ComposerHeightConverter x:Key="ComposerHeightConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style TargetType="{x:Type controls:MarkdownTextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style x:Key="SelectableMessageViewerStyle" TargetType="{x:Type controls:SelectableMarkdownViewer}">
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsReadOnlyCaretVisible" Value="False" />
            <Setter Property="IsDocumentEnabled" Value="True" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}" />
            <Setter Property="CaretBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
        </Style>

        <Style x:Key="MessageTextBoxStyle" TargetType="TextBox">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}" />
        </Style>

        <Style x:Key="VSCodexComboBoxEditableTextBoxStyle" TargetType="TextBox">
            <Setter Property="AcceptsReturn" Value="False" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBackgroundBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBorderBrushKey}}" />
            <Setter Property="CaretBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxTextBrushKey}}" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBackgroundBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBorderBrushKey}}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxTextBrushKey}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid SnapsToDevicePixels="True">
                            <ToggleButton
                                x:Name="DropDownToggle"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                ClickMode="Press"
                                Focusable="False"
                                Foreground="{TemplateBinding Foreground}"
                                IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border
                                            x:Name="ToggleBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <Path
                                                    x:Name="Arrow"
                                                    Width="8"
                                                    Height="5"
                                                    Margin="0,0,8,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Data="M 0 0 L 4 4 L 8 0 Z"
                                                    Fill="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxTextBrushKey}}" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxFocusedBackgroundBrushKey}}" />
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxFocusedBorderBrushKey}}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxFocusedBackgroundBrushKey}}" />
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxFocusedBorderBrushKey}}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxDisabledBackgroundBrushKey}}" />
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxDisabledBorderBrushKey}}" />
                                                <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxDisabledTextBrushKey}}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter
                                x:Name="ContentSite"
                                Margin="8,3,26,3"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                IsHitTestVisible="False" />
                            <TextBox
                                x:Name="PART_EditableTextBox"
                                Margin="4,3,26,3"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                IsReadOnly="{TemplateBinding IsReadOnly}"
                                Style="{StaticResource VSCodexComboBoxEditableTextBoxStyle}"
                                Visibility="Hidden" />
                            <Popup
                                x:Name="Popup"
                                AllowsTransparency="True"
                                Focusable="False"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                Placement="Bottom"
                                PopupAnimation="Slide">
                                <Grid MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border
                                        Background="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxPopupBackgroundBeginBrushKey}}"
                                        BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBorderBrushKey}}"
                                        BorderThickness="1" />
                                    <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxFocusedBackgroundBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxFocusedTextBrushKey}}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxFocusedBorderBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxDisabledBackgroundBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxDisabledTextBrushKey}}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxDisabledBorderBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxFocusedBackgroundBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxFocusedTextBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxFocusedBorderBrushKey}}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxDisabledBackgroundBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxDisabledTextBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxDisabledBorderBrushKey}}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxPopupBackgroundBeginBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxItemTextBrushKey}}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxItemMouseOverBackgroundBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxItemMouseOverTextBrushKey}}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxSelectionBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}" />
        </Style>

        <Style
            x:Key="CompactButtonStyle"
            BasedOn="{StaticResource {x:Type Button}}"
            TargetType="Button">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,0,5,5" />
        </Style>

        <Style
            x:Key="ActionChipButtonStyle"
            BasedOn="{StaticResource CompactButtonStyle}"
            TargetType="Button">
            <Setter Property="MinHeight" Value="25" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarGradientBeginBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarTextActiveBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarBorderBrushKey}}" />
        </Style>

        <Style
            x:Key="ComposerPromptTextBoxStyle"
            BasedOn="{StaticResource {x:Type TextBox}}"
            TargetType="TextBox">
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CaretBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
        </Style>

        <Style
            x:Key="ComposerChipTextStyle"
            BasedOn="{StaticResource {x:Type TextBlock}}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,5,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.SystemGrayTextBrushKey}}" />
            <Setter Property="Opacity" Value="0.88" />
        </Style>

        <Style
            x:Key="IconButtonStyle"
            BasedOn="{StaticResource CompactButtonStyle}"
            TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="IconBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconBorder" Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.FileTabSelectedBackgroundBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="IconBorder" Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.FileTabSelectedBorderBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="IconBorder" Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.FileTabSelectedBackgroundBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="IconBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NativeIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
                <imaging:CrispImage Width="16" Height="16" Moniker="{Binding}" />
            </DataTemplate></Setter.Value></Setter>
        </Style>

        <Style
            x:Key="VoiceInputButtonStyle"
            BasedOn="{StaticResource IconButtonStyle}"
            TargetType="Button">
            <Setter Property="ToolTip" Value="{Binding VoiceInputStatus}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsListeningToVoice}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.FileTabSelectedBackgroundBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.FileTabSelectedBorderBrushKey}}" />
                    <Setter Property="ToolTip" Value="正在聆听。点击可停止 VSCodex 语音输入。" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="PrimaryRunButtonStyle"
            BasedOn="{StaticResource IconButtonStyle}"
            TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="ToolTip" Value="发送" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunControlInStopMode}" Value="True">
                    <Setter Property="ToolTip" Value="停止" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="Margin" Value="0,2,0,8" />
        </Style>

        <Style x:Key="PromptResizeThumbStyle" TargetType="{x:Type primitives:Thumb}">
            <Setter Property="Height" Value="7" />
            <Setter Property="Cursor" Value="SizeNS" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                        <Border
                            Height="{TemplateBinding Height}"
                            Background="{TemplateBinding Background}"
                            ToolTip="{TemplateBinding ToolTip}">
                            <Border
                                Width="42"
                                Height="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TreeView">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ToggleButton x:Name="Expander" VerticalAlignment="Top"
                                          Background="Transparent" BorderThickness="0"
                                          Foreground="{TemplateBinding Foreground}"
                                          Content="+" Focusable="False"
                                          AutomationProperties.Name="展开或折叠活动"
                                          ToolTip="展开或折叠此活动。"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header"
                                              HorizontalAlignment="Stretch" />
                            <ItemsPresenter x:Name="Children" Grid.Row="1" Grid.Column="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="Children" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Expander" Property="Content" Value="-" />
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasItems, RelativeSource={RelativeSource Self}}" Value="False" />
                                    <Condition Binding="{Binding HasDetail}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type models:RunActivityNode}" ItemsSource="{Binding Children}">
            <Border
                Margin="2,2,4,4"
                Padding="4,3"
                Background="Transparent">
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <Button
                            Margin="5,0,0,0"
                            AutomationProperties.Name="复制 VSCodex 回复文本"
                            Command="{Binding DataContext.CopyActivityDetailCommand, RelativeSource={RelativeSource AncestorType=TreeView}}"
                            CommandParameter="{Binding}"
                            DockPanel.Dock="Right"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="复制这段 VSCodex 回复文本。">
                            <Button.Visibility>
                                <Binding Converter="{StaticResource BooleanToVisibilityConverter}" Path="HasDetail" />
                            </Button.Visibility>
                            <Viewbox
                                Width="13"
                                Height="13"
                                Stretch="Uniform">
                                <Grid Width="16" Height="16">
                                    <Path
                                        Data="M6,5 L13,5 L13,14 L6,14 Z M3,2 L10,2 L10,4 M3,2 L3,11 L5,11"
                                        Fill="Transparent"
                                        Stroke="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
                                        StrokeEndLineCap="Square"
                                        StrokeLineJoin="Miter"
                                        StrokeThickness="1.4" />
                                </Grid>
                            </Viewbox>
                        </Button>
                        <TextBlock
                            Margin="8,0,0,0"
                            DockPanel.Dock="Right"
                            FontSize="11"
                            Opacity="0.62"
                            Text="{Binding TimestampText}"
                            TextAlignment="Right" />
                        <Button
                            Margin="0"
                            AutomationProperties.Name="打开已更改的文件"
                            Command="{Binding DataContext.OpenActivityFileCommand, RelativeSource={RelativeSource AncestorType=TreeView}}"
                            CommandParameter="{Binding}"
                            Content="{Binding HeaderText}"
                            ToolTip="{Binding FilePath}"
                            Visibility="{Binding CanOpenFile, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button.Style>
                                <Style
                                    BasedOn="{StaticResource CompactButtonStyle}"
                                    TargetType="Button">
                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding HeaderText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanOpenFile}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowValidationErrorTextBrushKey}}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                    <controls:SelectableMarkdownViewer
                        HorizontalAlignment="Stretch"
                        Markdown="{Binding Detail}">
                        <controls:SelectableMarkdownViewer.Style>
                            <Style
                                BasedOn="{StaticResource SelectableMessageViewerStyle}"
                                TargetType="{x:Type controls:SelectableMarkdownViewer}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDetail}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFileNode}" Value="True">
                                        <Setter Property="Margin" Value="16,2,0,0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:SelectableMarkdownViewer.Style>
                    </controls:SelectableMarkdownViewer>
                </StackPanel>
            </Border>
        </HierarchicalDataTemplate>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.FileTabBackgroundBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.FileTabTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.FileTabBorderBrushKey}}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border
                            x:Name="TabBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1">
                            <ContentPresenter
                                x:Name="HeaderSite"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ContentSource="Header"
                                RecognizesAccessKey="True"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.FileTabHotTextBrushKey}}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.FileTabHotBorderBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.FileTabSelectedBackgroundBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.FileTabSelectedTextBrushKey}}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.FileTabSelectedBorderBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.FileTabInactiveTextBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.FileTabSelectedBackgroundBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.FileTabSelectedTextBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.FileTabSelectedBorderBrushKey}}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}" />
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}" />
        </Style>

        <Style TargetType="controls:ProgressRing">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.FileTabSelectedTextBrushKey}}" />
            <Setter Property="CoverRingStroke" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}" />
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}" />
        </Style>

        <Style TargetType="StatusBar">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
        </Style>

        <Style TargetType="StatusBarItem">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
        </Style>

        <Style x:Key="SectionHeaderTextBlock" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,6" />
        </Style>

        <Style x:Key="FieldLabelTextBlock" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="Opacity" Value="0.78" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <Style x:Key="SettingsSectionBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="10" />
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowCodeBlockBackgroundBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style x:Key="SettingsSectionHeadingStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="SettingsMutedTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.68" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <DataTemplate x:Key="RateLimitTemplate">
            <Grid Margin="0,0,0,7" ToolTip="{Binding ToolTip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    FontWeight="SemiBold"
                    Text="{Binding Label}" />
                <TextBlock
                    Grid.Column="1"
                    Opacity="0.86"
                    Text="{Binding Remaining}"
                    TextTrimming="CharacterEllipsis" />
                <controls:ProgressRing
                    Grid.Column="2"
                    Width="15"
                    Height="15"
                    Margin="5,0"
                    Progress="{Binding UsagePercent}"
                    Visibility="{Binding HasTelemetry, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock
                    Grid.Column="3"
                    Margin="8,0,0,0"
                    Opacity="0.72"
                    Text="{Binding ResetText}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="10,7"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                    <Image
                        Width="20"
                        Height="20"
                        Margin="0,0,7,6"
                        VerticalAlignment="Center"
                        Source="/VSCodex;component/Resources/VSCodexIcon-32.png"
                        ToolTip="VSCodex" />
                    <Button
                        AutomationProperties.Name="新建 VSCodex 线程"
                        Command="{Binding NewThreadCommand}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="开始一个新的 VSCodex 线程。">
                        <Viewbox
                            Width="14"
                            Height="14"
                            Stretch="Uniform">
                            <Grid Width="16" Height="16">
                                <Path
                                    Data="M3,2 L10,2 L13,5 L13,14 L3,14 Z M10,2 L10,5 L13,5"
                                    Fill="Transparent"
                                    Stroke="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
                                    StrokeEndLineCap="Square"
                                    StrokeLineJoin="Miter"
                                    StrokeThickness="1.4" />
                                <Path
                                    Data="M5,9 L11,9 M8,6 L8,12"
                                    Stroke="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
                                    StrokeEndLineCap="Square"
                                    StrokeThickness="1.4" />
                            </Grid>
                        </Viewbox>
                    </Button>
                    <Button
                        AutomationProperties.Name="打开 VSCodex 历史"
                        Command="{Binding ShowHistoryCommand}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="打开 VSCodex 会话历史。">
                        <Viewbox
                            Width="15"
                            Height="15"
                            Stretch="Uniform">
                            <Grid Width="16" Height="16">
                                <Path
                                    Data="M8,2 A6,6 0 1 1 3.8,3.8 M3.8,3.8 L3.8,6.8 M3.8,3.8 L6.8,3.8"
                                    Stroke="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
                                    StrokeEndLineCap="Square"
                                    StrokeLineJoin="Miter"
                                    StrokeThickness="1.4" />
                                <Path
                                    Data="M8,5 L8,8.2 L11,9.8"
                                    Stroke="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
                                    StrokeEndLineCap="Square"
                                    StrokeLineJoin="Miter"
                                    StrokeThickness="1.4" />
                            </Grid>
                        </Viewbox>
                    </Button>
                    <Button
                        AutomationProperties.Name="打开 VSCodex 设置"
                        Click="OnOpenSettingsClick"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="在 Visual Studio 选项中打开 VSCodex 设置。">
                        <Viewbox
                            Width="15"
                            Height="15"
                            Stretch="Uniform">
                            <Grid Width="16" Height="16">
                                <Path
                                    Data="M8,5.2 A2.8,2.8 0 1 1 8,10.8 A2.8,2.8 0 0 1 8,5.2 Z M8,1.5 L9.1,1.5 L9.6,3.2 A5.1,5.1 0 0 1 10.9,3.8 L12.5,3 L13.3,3.8 L12.5,5.4 A5.1,5.1 0 0 1 13.1,6.7 L14.8,7.2 L14.8,8.8 L13.1,9.3 A5.1,5.1 0 0 1 12.5,10.6 L13.3,12.2 L12.2,13.3 L10.6,12.5 A5.1,5.1 0 0 1 9.3,13.1 L8.8,14.8 L7.2,14.8 L6.7,13.1 A5.1,5.1 0 0 1 5.4,12.5 L3.8,13.3 L2.7,12.2 L3.5,10.6 A5.1,5.1 0 0 1 2.9,9.3 L1.2,8.8 L1.2,7.2 L2.9,6.7 A5.1,5.1 0 0 1 3.5,5.4 L2.7,3.8 L3.8,2.7 L5.4,3.5 A5.1,5.1 0 0 1 6.7,2.9 L7.2,1.5 Z"
                                    Fill="Transparent"
                                    Stroke="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
                                    StrokeEndLineCap="Square"
                                    StrokeLineJoin="Miter"
                                    StrokeThickness="1.2" />
                            </Grid>
                        </Viewbox>
                    </Button>
                </WrapPanel>

                <ItemsControl Grid.Row="1" Margin="0,2,0,2"
                              AutomationProperties.Name="剩余速率限制"
                              ItemTemplate="{StaticResource RateLimitTemplate}"
                              ItemsSource="{Binding RateLimits}" />
                <TextBlock
                    Grid.Row="2"
                    Margin="0,0,0,2"
                    FontSize="11"
                    Opacity="0.62"
                    Text="{Binding CurrentWorkspaceDisplay}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer
                x:Name="ConversationScrollViewer"
                HorizontalScrollBarVisibility="Disabled"
                PreviewMouseWheel="OnConversationMouseWheel"
                VerticalScrollBarVisibility="Auto">
                <TreeView
                    x:Name="ConversationTree"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    BorderThickness="0"
                    ItemsSource="{Binding RunActivityRoots}"
                    ScrollViewer.CanContentScroll="False" />
            </ScrollViewer>
        </Grid>

        <DockPanel
            Grid.Row="1"
            Grid.RowSpan="2"
            Width="620"
            MinWidth="0"
            MaxWidth="{Binding ActualWidth, ElementName=Root}"
            HorizontalAlignment="Right"
            Panel.ZIndex="10"
            Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
            Visibility="{Binding IsToolPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border
                Padding="8,6"
                BorderThickness="0,0,0,1"
                DockPanel.Dock="Top">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="工作区" />
                    <Button ToolTip="设置。"
                        Grid.Column="1"
                        Margin="0,0,6,0"
                        AutomationProperties.Name="打开 VSCodex 设置"
                        Click="OnOpenSettingsClick"
                        Content="{x:Static catalog:KnownMonikers.Settings}"
                        Style="{StaticResource NativeIconButtonStyle}" />
                    <Button ToolTip="关闭。"
                        Grid.Column="2"
                        Margin="0"
                        AutomationProperties.Name="关闭 VSCodex 工作区"
                        Click="OnCloseToolPanelClick"
                        Content="{x:Static catalog:KnownMonikers.Close}"
                        Style="{StaticResource NativeIconButtonStyle}" />
                </Grid>
            </Border>
            <TabControl
                Margin="0"
                SelectedIndex="{Binding SelectedToolTabIndex, Mode=TwoWay}">
                <TabItem Header="历史">
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBox
                                Margin="0,0,0,8"
                                AcceptsReturn="False"
                                Text="{Binding HistorySearchText, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="搜索 VSCodex 会话历史。" />
                            <WrapPanel>
                                <Button ToolTip="新建线程。" AutomationProperties.Name="新建线程"
                                    Command="{Binding NewThreadCommand}"
                                    Content="{x:Static catalog:KnownMonikers.Add}"
                                    Style="{StaticResource NativeIconButtonStyle}" />
                                <Button ToolTip="刷新。" AutomationProperties.Name="刷新"
                                    Command="{Binding RefreshHistoryCommand}"
                                    Content="{x:Static catalog:KnownMonikers.Refresh}"
                                    Style="{StaticResource NativeIconButtonStyle}" />
                                <Button Command="{Binding RefreshThreadsCommand}" AutomationProperties.Name="导入 Codex 线程" ToolTip="从 Codex 刷新线程。" Style="{StaticResource NativeIconButtonStyle}" Content="{x:Static catalog:KnownMonikers.Refresh}" />
                                <Button Command="{Binding ForkSessionCommand}" CommandParameter="{Binding SelectedHistoryItem}" AutomationProperties.Name="分叉所选会话" ToolTip="分叉所选会话。" Style="{StaticResource NativeIconButtonStyle}" Content="{x:Static catalog:KnownMonikers.Branch}" />
                                <Button Command="{Binding PinSessionCommand}" CommandParameter="{Binding SelectedHistoryItem}" AutomationProperties.Name="固定或取消固定所选会话" ToolTip="固定或取消固定所选会话。" Style="{StaticResource NativeIconButtonStyle}" Content="{x:Static catalog:KnownMonikers.Pin}" />
                                <Button Command="{Binding ArchiveSessionCommand}" CommandParameter="{Binding SelectedHistoryItem}" AutomationProperties.Name="归档或恢复所选会话" ToolTip="归档或恢复所选会话。" Style="{StaticResource NativeIconButtonStyle}" Content="{x:Static catalog:KnownMonikers.OpenFolder}" />
                            </WrapPanel>
                            <CheckBox Content="包含已归档会话" IsChecked="{Binding IncludeArchivedSessions}" ToolTip="在历史中显示已归档会话。" />
                        </StackPanel>
                        <ListBox
                            ItemsSource="{Binding VisibleHistoryItems}"
                            MouseDoubleClick="OnHistoryItemDoubleClick"
                            SelectedItem="{Binding SelectedHistoryItem, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="2,4"
                                        Padding="8"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <StackPanel>
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{Binding Title}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBox
                                                Margin="0,6,0,4"
                                                AcceptsReturn="False"
                                                Text="{Binding DraftTitle, UpdateSourceTrigger=PropertyChanged}"
                                                Visibility="{Binding IsRenaming, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock
                                                Margin="0,3,0,0"
                                                Opacity="0.72"
                                                Text="{Binding Preview}"
                                                TextTrimming="CharacterEllipsis" />
                                            <DockPanel Margin="0,6,0,0">
                                                <TextBlock
                                                    DockPanel.Dock="Left"
                                                    FontSize="11"
                                                    Opacity="0.66"
                                                    Text="{Binding UpdatedDisplay}" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    DockPanel.Dock="Left"
                                                    FontSize="11"
                                                    Opacity="0.66"
                                                    Text="{Binding MessageCountDisplay}" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    DockPanel.Dock="Left"
                                                    FontSize="11"
                                                    Opacity="0.66"
                                                    Text="{Binding WorkspaceDisplay}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <WrapPanel Margin="0,8,0,0">
                                                <Button ToolTip="打开。" AutomationProperties.Name="打开"
                                                    Command="{Binding DataContext.LoadHistoryCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}"
                                                    Content="{x:Static catalog:KnownMonikers.OpenFolder}"
                                                    Style="{StaticResource NativeIconButtonStyle}" />
                                                <Button ToolTip="重命名。" AutomationProperties.Name="重命名"
                                                    Command="{Binding DataContext.BeginRenameHistoryCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}"
                                                    Content="{x:Static catalog:KnownMonikers.Rename}"
                                                    Style="{StaticResource NativeIconButtonStyle}" />
                                                <Button ToolTip="保存。" AutomationProperties.Name="保存"
                                                    Command="{Binding DataContext.SaveRenameHistoryCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}"
                                                    Content="{x:Static catalog:KnownMonikers.Save}"
                                                    Style="{StaticResource NativeIconButtonStyle}"
                                                    Visibility="{Binding IsRenaming, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <Button ToolTip="放弃。" AutomationProperties.Name="放弃"
                                                    Command="{Binding DataContext.CancelRenameHistoryCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}"
                                                    Content="{x:Static catalog:KnownMonikers.Cancel}"
                                                    Style="{StaticResource NativeIconButtonStyle}"
                                                    Visibility="{Binding IsRenaming, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <Button ToolTip="删除。" AutomationProperties.Name="删除"
                                                    Command="{Binding DataContext.DeleteHistoryCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}"
                                                    Content="{x:Static catalog:KnownMonikers.Delete}"
                                                    Style="{StaticResource NativeIconButtonStyle}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>

                <TabItem Header="配置" Visibility="Collapsed">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12">
                            <TextBlock FontWeight="SemiBold" Text="{Binding CodexSetupSummary}" />
                            <TextBlock
                                Margin="0,6,0,10"
                                Opacity="0.72"
                                Text="{Binding CodexSetupInstructions}" />
                            <Button AutomationProperties.Name="检查"
                                HorizontalAlignment="Left"
                                Command="{Binding CheckPrerequisitesCommand}"
                                Content="{x:Static catalog:KnownMonikers.Checkmark}"
                                Style="{StaticResource NativeIconButtonStyle}"
                                ToolTip="重新检查 VSCodex 的前置条件。" />
                            <ItemsControl ItemsSource="{Binding Prerequisites}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,6,0,0"
                                            Padding="8"
                                            BorderThickness="1"
                                            CornerRadius="3">
                                            <StackPanel>
                                                <DockPanel LastChildFill="True">
                                                    <TextBlock
                                                        DockPanel.Dock="Left"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding Name}" />
                                                    <TextBlock
                                                        Margin="8,0,0,0"
                                                        DockPanel.Dock="Right"
                                                        Opacity="0.72"
                                                        Text="{Binding Status}" />
                                                </DockPanel>
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    Opacity="0.76"
                                                    Text="{Binding Description}" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    Opacity="0.66"
                                                    Text="{Binding Details}" />
                                                <WrapPanel Margin="0,8,0,0">
                                                    <Button AutomationProperties.Name="复制命令"
                                                        Command="{Binding DataContext.CopyPrerequisiteCommand, ElementName=Root}"
                                                        CommandParameter="{Binding}"
                                                        Content="{x:Static catalog:KnownMonikers.Copy}"
                                                        Style="{StaticResource NativeIconButtonStyle}"
                                                        ToolTip="{Binding ActionCommand}"
                                                        Visibility="{Binding CanCopyCommand, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <Button
                                                        Command="{Binding DataContext.UpdatePrerequisiteCommand, ElementName=Root}"
                                                        CommandParameter="{Binding}"
                                                        Content="{Binding ActionButtonText}"
                                                        Style="{StaticResource CompactButtonStyle}"
                                                        ToolTip="{Binding ActionCommand}"
                                                        Visibility="{Binding CanUpdate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="上下文">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <GroupBox
                            Grid.Row="0"
                            Margin="0,0,0,8"
                            Header="@ 文件">
                            <ListBox ItemsSource="{Binding FileSuggestions}" MouseDoubleClick="OnReferenceSuggestionDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="6">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding ReferenceKey}" />
                                            <TextBlock Opacity="0.72" Text="{Binding RelativePath}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </GroupBox>
                        <GroupBox Grid.Row="1" Header="# 引用">
                            <ListBox ItemsSource="{Binding ContextSuggestions}" MouseDoubleClick="OnReferenceSuggestionDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="6">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding ReferenceKey}" />
                                            <TextBlock Opacity="0.72" Text="{Binding ReferenceKind}" />
                                            <TextBlock Opacity="0.72" Text="{Binding RelativePath}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <TabItem Header="技能" Visibility="Collapsed">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource SettingsMutedTextStyle}"
                                Text="{Binding UserSkillsRoot}" />
                            <WrapPanel Grid.Column="1">
