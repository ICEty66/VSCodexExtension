                                                    Content="{x:Static catalog:KnownMonikers.ToolBox}"
                                                    Style="{StaticResource NativeIconButtonStyle}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <GridSplitter
                                Grid.Column="1"
                                Width="10"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />

                            <Border Grid.Column="2" Style="{StaticResource SettingsSectionBorderStyle}">
