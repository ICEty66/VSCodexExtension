                                        BorderThickness="0"
                                        ItemsSource="{Binding McpToolSuggestions}"
                                        SelectedItem="{Binding SelectedMcpTool}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                <TextBlock
                                                    Grid.Row="1"
                                                    Opacity="0.72"
                                                    Text="{Binding Description}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <Button ToolTip="使用工具。" AutomationProperties.Name="使用工具"
                                                    Grid.Row="2"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding DataContext.SelectMcpToolCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}"
                                                    Content="{x:Static catalog:KnownMonikers.ToolBox}"
                                                    Style="{StaticResource NativeIconButtonStyle}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <GridSplitter
                                Grid.Column="1"
