                                Command="{Binding AddImageAttachmentCommand}"
                                Content="{x:Static catalog:KnownMonikers.AddAttachment}"
                                Style="{StaticResource NativeIconButtonStyle}" />
                            <Button ToolTip="清除附件。" AutomationProperties.Name="清除附件"
                                Command="{Binding ClearAttachmentsCommand}"
                                Content="{x:Static catalog:KnownMonikers.DeleteAttachment}"
                                Style="{StaticResource NativeIconButtonStyle}" />
                        </WrapPanel>
                        <ListBox ItemsSource="{Binding Attachments}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="6">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
